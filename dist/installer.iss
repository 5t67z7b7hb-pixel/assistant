; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=AI Mock Interview Helper
AppVersion=1.0
DefaultDirName={autopf}\AIInterviewHelper
DefaultGroupName=AI Mock Interview Helper
OutputBaseFilename=AIInterviewHelperSetup
Compression=lzma2
SolidCompression=yes
PrivilegesRequired=lowest

[Files]
Source: "dist\LightningAssistant\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\AI Mock Interview Helper"; Filename: "{app}\LightningAssistant.exe"
Name: "{autodesktop}\AI Mock Interview Helper"; Filename: "{app}\LightningAssistant.exe"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop icon"; GroupDescription: "Additional icons:"